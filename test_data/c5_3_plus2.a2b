    "editor_prog": "#1 5 01 +\n(once)=z\n(once)+=+z\nz0=(return)error\nz1=1\nf=(end)g\n(end)+1=e\n(start)e=1\n0g=g1\n1g=0\n1e=e0\n0e=1\n+0=+\n+1=e+f1"
